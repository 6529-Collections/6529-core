<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  6529 Desktop: the bundled Node.js runtime, Contents/Resources/node/bin/node.
  Used by .github/workflows/sign-desktop.yml with the hardened runtime.

  allow-jit: V8 compiles JavaScript to machine code at run time into memory
    mapped with MAP_JIT. Under the hardened runtime that mapping is refused
    without this entitlement, and node aborts at start.
  allow-unsigned-executable-memory: V8 and its WebAssembly tiers also make
    executable pages that are not MAP_JIT mappings. Node's own macOS
    release signs node with this entitlement for the same reason.

  Not granted, on purpose:
  - disable-library-validation: node loads one native addon (sharp's
    .node) and its libvips dylib; the workflow signs both with the same
    Developer ID, so library validation accepts them.
  - disable-executable-page-protection, allow-dyld-environment-variables:
    not needed to run the web server.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
