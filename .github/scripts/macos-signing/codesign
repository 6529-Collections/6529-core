#!/usr/bin/env node

const { spawnSync } = require("node:child_process");

// Bound a stuck codesign process without timing out the full desktop build.
const timeoutMinutes = 5;
const { error, signal, status } = spawnSync("/usr/bin/codesign", process.argv.slice(2), {
  stdio: "inherit",
  timeout: timeoutMinutes * 60_000,
  killSignal: "SIGKILL",
});

if (error?.code === "ETIMEDOUT") {
  console.error(`codesign timed out after ${timeoutMinutes} minutes`);
  process.exitCode = 124;
} else if (error) {
  console.error(error.message);
  process.exitCode = 1;
} else if (signal) {
  console.error(`codesign was terminated by ${signal}`);
  process.exitCode = 1;
} else {
  process.exitCode = status;
}
